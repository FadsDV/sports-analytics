# Odds Providers
THE_ODDS_API_KEY=your_the_odds_api_key_here
PANDASCORE_API_KEY=your_pandascore_api_key_here

# Vercel Blob — slip cache (freeze kitchen slips when game goes live)
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Sofascore proxy — Cloudflare Worker URL to bypass Vercel's blocked IPs
# Deploy the worker from docs/cloudflare-sofa-worker.js, then set this
SOFASCORE_PROXY_BASE=https://sofa.yourname.workers.dev
